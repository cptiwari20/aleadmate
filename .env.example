# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database (Neon Postgres) ---
# Pooled connection, used at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"
# Direct (unpooled) connection, used for `prisma db push` and migrations.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require"

# --- Auth (better-auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth. Console: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Admin ---
# Comma-separated allowlist for /admin/waitlist. Deliberately an env var, not a
# database flag: only someone who can deploy should be able to grant access.
ADMIN_EMAILS=""

# --- Slack ---
# Workflow trigger that receives each completed waitlist signup.
# Treat as a credential: anyone holding this URL can post into the workspace.
# Must be an https://hooks.slack.com/... URL — the app refuses any other host,
# because the payload contains names, emails and phone numbers.
SLACK_WAITLIST_WEBHOOK_URL=""

# --- Email (Resend) — magic links and the weekly digest ---
RESEND_API_KEY=""
EMAIL_FROM="aLeadMate <hello@aleadmate.com>"
